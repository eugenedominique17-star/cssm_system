{
  "dependencies": {
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.111.0",
    "framer-motion": "^13.5.1",
    "motion": "^14.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "scripts": {
    "postinstall": "npm ci --prefix backend && npm ci --prefix frontend",
    "start": "node backend/server.js",
    "build": "npm --prefix frontend run build",
    "build:low-memory": "node --max-old-space-size=768 --max-semi-space-size=8 frontend/scripts/build-low-memory.cjs",
    "dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm start\""
  },
  "engines": { "node": ">=22 <25" }
}
