# Supabase Configuration
# Get these values from your Supabase project settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-backend-secret-key-here

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration (generate a long random value for production)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=24h
# 32-byte hex or base64 key used only for encrypted previous-password audit secrets
AUDIT_SECRET_KEY=replace-with-64-hex-characters
# Encrypted previous-password audit-secret retention window
AUDIT_SECRET_RETENTION_DAYS=90
# Leave unset for direct local access. Configure only for your verified proxy topology.
# TRUST_PROXY=1
